---
import BaseLayout from '../components/BaseLayout.astro';
import { AstroContent } from '../persistence/AstroContent.ts';

const committee = await AstroContent.loadCommittee();
const facilitator = committee.facilitator;
---

<BaseLayout
  title="Contact us"
  description="How to reach the merger committee's facilitator and each district's contact, send a comment, or ask for a record or another format."
  updatedOn={committee.membersUpdatedOn}
>
  <h1>Contact us</h1>
  <p class="lede">
    Write to the facilitator about meetings, comments, records, and access requests. You may also write to the
    contact for your own district.
  </p>

  <section aria-labelledby="facilitator">
    <div class="panel">
      <h2 id="facilitator">Facilitator</h2>
      <p>
        <strong>{facilitator.name}</strong><br />
        {facilitator.title}, {facilitator.organization}<br />
        Email: <a href={`mailto:${facilitator.email}`}>{facilitator.email}</a><br />
        Phone ({facilitator.organization} office): <a href={facilitator.telephoneHref()}>{facilitator.phone}</a>
      </p>
    </div>
  </section>

  <section aria-labelledby="district-contacts">
    <h2 id="district-contacts">District contacts</h2>
    <ul class="plain-list">
      {
        committee.delegations().map((delegation) => {
          const contactMember = delegation.contactMember();
          return (
            <li>
              <h3 class="item-title">{delegation.district.name}</h3>
              {contactMember?.email && (
                <p>
                  {contactMember.name}, {contactMember.contactRole()}
                  <br />
                  Email: <a href={`mailto:${contactMember.email}`}>{contactMember.email}</a>
                </p>
              )}
              <p>
                District office: <a href={delegation.district.telephoneHref()}>{delegation.district.phone}</a>
                <br />
                <a href={delegation.district.website}>{delegation.district.name} website</a>
              </p>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section aria-labelledby="what-to-include">
    <h2 id="what-to-include">What to include</h2>
    <ul>
      <li>
        <strong>A comment for a meeting:</strong> your name, your town, the meeting date, and your comment. Send it
        before the meeting.
      </li>
      <li>
        <strong>A request for phone, video, or in-person access:</strong> the meeting date. Send it at least 2 business
        days before the meeting.
      </li>
      <li><strong>A request for a record:</strong> what you are looking for and how you want to get it.</li>
      <li><strong>Another format or language:</strong> the page or file, and what format or language you need.</li>
      <li><strong>A problem with this website:</strong> the page and what went wrong.</li>
    </ul>
  </section>
</BaseLayout>
