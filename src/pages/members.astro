---
import BaseLayout from '../components/BaseLayout.astro';
import { AstroContent } from '../persistence/AstroContent.ts';

const committee = await AstroContent.loadCommittee();
const facilitator = committee.facilitator;
---

<BaseLayout
  title="Committee members"
  description="The school board members from Burlington, South Burlington, and Winooski who serve on the Act 170 merger committee."
  updatedOn={committee.membersUpdatedOn}
>
  <h1>Committee members</h1>
  <p class="lede">
    Every member is an active School Board member. {committee.chair.name} is the chair of the merger committee.
  </p>
  <p>
    Based on Act 170, 
    the committee decided that {committee.proportionalRepresentation.summary()}.
  </p>

  {
    committee.delegations().map((delegation) => (
      <section aria-labelledby={`district-${delegation.district.id}`}>
        <h2 id={`district-${delegation.district.id}`}>{delegation.district.name}</h2>
        <p>
          {delegation.district.averageDailyMembership.describe()}, {delegation.votes.label()} on the committee.{' '}
          <a href={delegation.district.averageDailyMembership.sourceUrl}>
            Source<span class="visually-hidden"> for the {delegation.district.name} student count</span>
          </a>
        </p>
        <ul class="plain-list">
          {delegation.members.map((member) => (
            <li>
              <span class="item-title">{member.name}</span>
              <br />
              {member.roleDescription()}
            </li>
          ))}
        </ul>
        {delegation.alternates.length > 0 && (
          <>
            <h3>Alternates</h3>
            <ul class="plain-list">
              {delegation.alternates.map((member) => (
                <li>
                  <span class="item-title">{member.name}</span>
                  <br />
                  {member.roleDescription()}
                </li>
              ))}
            </ul>
          </>
        )}
      </section>
    ))
  }

  <h2>Facilitator</h2>
  <p>
    <span class="item-title">{facilitator.name}</span><br />
    {facilitator.title}, <a href={facilitator.organizationUrl}>{facilitator.organization}</a>. The facilitator runs
    the meetings and stays neutral on whether to merge. The facilitator is not a member and does not vote.{' '}
    <a href={facilitator.sourceUrl}>Source<span class="visually-hidden"> for the facilitator's role</span></a>
  </p>

  <p><a href="/contact/">How to reach the committee</a></p>
</BaseLayout>
