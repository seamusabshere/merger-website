---
import BaseLayout from '../components/BaseLayout.astro';
import MeetingJoinDetails from '../components/MeetingJoinDetails.astro';
import { VermontTime } from '../domain/VermontTime.ts';
import { AstroContent } from '../persistence/AstroContent.ts';

const committee = await AstroContent.loadCommittee();
const now = VermontTime.now();
const nextMeeting = committee.nextMeeting({ now });
---

<BaseLayout
  title="Home"
  description="The Burlington, South Burlington, and Winooski school districts are studying whether to merge under Vermont's Act 170. Meetings, records, and how to take part."
  updatedOn={committee.updatedOn()}
>
  <h1>Should our three school districts become one?</h1>
  <p class="lede">
    A Vermont law, Act 170, requires the Burlington, South Burlington, and Winooski school districts to study that
    question together. A committee of school board members from all three districts is doing the study.{' '}
    <strong>The committee has not decided anything.</strong>
  </p>

  <section aria-labelledby="next-meeting">
    <div class="panel">
      <h2 id="next-meeting">Next meeting</h2>
      {
        nextMeeting ? (
          <>
            <MeetingJoinDetails meeting={nextMeeting} />
            {nextMeeting.hasPostedAgenda() && (
              <p>
                <a href={`${nextMeeting.path()}#agenda`}>Read the agenda</a>
              </p>
            )}
            <p>
              <a class="button" href={nextMeeting.path()}>
                Meeting details
              </a>{' '}
              <a class="button" href={nextMeeting.calendarFilePath()}>
                Add to calendar
              </a>
            </p>
          </>
        ) : (
          <p>No meeting is scheduled yet. See <a href="/meetings/">past meetings</a>.</p>
        )
      }
    </div>
  </section>

  <section aria-labelledby="take-part">
    <h2 id="take-part">Take part</h2>
    <p>
      Anyone may attend, in person, by video, or by phone. Each meeting has time for public input, and you may send a
      written comment to be read aloud. <a href="/participate/">How to participate</a>.
    </p>
  </section>

  <section aria-labelledby="the-study">
    <h2 id="the-study">What the committee is studying</h2>
    <p>
      <a href="https://legislature.vermont.gov/Documents/2026/Docs/ACTS/ACT170/ACT170%20As%20Enacted.pdf">Act 170, Sec. 13(b)(4)(D)</a>
      says:
    </p>
    <blockquote>
      <p>
        A merger committee formed pursuant to this section shall prepare a report with its final recommendations as to
        whether it is advisable or inadvisable to form a new unified union school district. In addition to the report
        requirements in <a href="https://legislature.vermont.gov/statutes/section/16/011/00708">16 V.S.A. § 708(c)</a>,
        the final report of each merger committee formed pursuant to this section shall include the following:
      </p>
    </blockquote>
    <ul>
      <li>
        Sec. 13(b)(4)(D)(ii): “an analysis of the strengths and challenges of the current structures of all ‘necessary’
        and ‘advisable’ school districts”
      </li>
      <li>
        Sec. 13(b)(4)(D)(iv): “an analysis of how the final recommendation will enable the merger committee member
        school districts to, under the foundation formula, maximize operational efficiencies, promote transparency and
        accountability, and encourage and support local decisions and actions that provide equal opportunities for an
        excellent education, all at a cost that parents, voters, and taxpayers value”
      </li>
      <li>
        Sec. 13(b)(4)(F)(i): “Each merger committee formed pursuant to this section shall consult with area career
        technical education (CTE) directors and shall document such consultation and any recommendations made by a CTE
        director in the merger committee’s final report issued pursuant to subdivision (D) of this subdivision (b)(4).
        The final report shall also include an analysis of how CTE access will be achieved for all students residing
        within the proposed new unified union school district.”
      </li>
    </ul>
    <p>
      Sec. 13(b)(4)(D)(i), (iii), and (v), Sec. 13(b)(4)(F)(ii), and 16 V.S.A. § 708(c) are quoted on
      <a href="/act-170/#report">What Act 170 says</a>.
    </p>
    <ul>
      <li>
        <a href="https://legislature.vermont.gov/Documents/2026/Docs/ACTS/ACT170/ACT170%20As%20Enacted.pdf">Sec. 13(b)(5)</a>:
        “On or before September 1, 2027, each merger committee shall complete its final report and transmit it, along
        with proposed articles of agreement, as applicable, to the school board of each school district that the report
        identifies as either ‘necessary’ or ‘advisable’ if the merger committee determined it was advisable to form a
        new unified union school district, or to the school board of each school district participating on the merger
        committee if the merger committee determined it was inadvisable to form a new unified union school district. The
        report shall be transmitted to the Secretary of Education and the State Board of Education at the same time. If
        a merger committee completes its work before September 1, 2027, the committee may transmit its report to the
        applicable school boards, the Secretary of Education, and the State Board of Education at any time the report
        is ready for review, subject to the provisions of subsections (c) and (d) of this section.”
      </li>
      <li>
        <a href="https://legislature.vermont.gov/Documents/2026/Docs/ACTS/ACT170/ACT170%20As%20Enacted.pdf">Sec. 13(d)</a>:
        “The State Board shall issue the findings required pursuant to 16 V.S.A. § 709(c)(2) on or before December 15,
        2027.”
      </li>
      <li>
        <a href="https://legislature.vermont.gov/Documents/2026/Docs/ACTS/ACT170/ACT170%20As%20Enacted.pdf">Sec. 13(e)</a>:
        “Notwithstanding 16 V.S.A. § 708(b)(2)(B) or any other provision of law to the contrary, if a merger committee
        formed pursuant to this section determines that it is advisable to propose the formation of a new unified union
        school district, the voters of each school district that is identified as ‘necessary’ or ‘advisable’ shall vote
        whether to form the proposed unified union school district, in accordance with 16 V.S.A. § 710, on March 7,
        2028.”
      </li>
    </ul>
    <p><a href="/act-170/">What Act 170 says</a> · <a href="/history/">History of school mergers in Vermont</a></p>
  </section>
</BaseLayout>
