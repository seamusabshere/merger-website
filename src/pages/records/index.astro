---
import BaseLayout from '../../components/BaseLayout.astro';
import RecordFileTable from '../../components/RecordFileTable.astro';
import { AstroContent } from '../../persistence/AstroContent.ts';

const committee = await AstroContent.loadCommittee();
const records = committee.records();
const recordsFromOtherSources = committee.recordsFromOtherSources();
---

<BaseLayout
  title="Public records"
  description="Files for the Burlington, South Burlington, and Winooski merger study. Committee files are listed first. Agendas and minutes are on each meeting page."
  updatedOn={committee.documentsUpdatedOn()}
>
  <h1>Public records</h1>
  <p>
    If you cannot read a file, <a href="/contact/">ask us for another format</a>.
  </p>

  <fieldset class="record-tabs">
    <legend class="visually-hidden">Which records to show</legend>
    <div class="record-tablist">
      <input
        class="record-tab-input"
        type="radio"
        name="record-source"
        id="published-by-the-committee"
        checked
      />
      <label for="published-by-the-committee">Published by the committee</label>
      <input class="record-tab-input" type="radio" name="record-source" id="other-sources" />
      <label for="other-sources">Other sources</label>
    </div>

    <div class="record-panel" id="published-by-the-committee-panel">
      <h2 class="visually-hidden">Published by the committee</h2>
      <RecordFileTable
        documents={records}
        committee={committee}
        caption="Files published by the committee"
        emptyMessage="The committee has not posted any files yet."
      />
    </div>

    <div class="record-panel" id="other-sources-panel">
      <h2 class="visually-hidden">Other sources</h2>
      <p>
        Laws, reports, and memos from state agencies, the Legislature, and the school districts.
      </p>
      <RecordFileTable
        documents={recordsFromOtherSources}
        committee={committee}
        caption="Useful public records from other sources"
        emptyMessage="No files from other sources are posted yet."
      />
    </div>
  </fieldset>
</BaseLayout>
