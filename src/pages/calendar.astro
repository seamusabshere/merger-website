---
import BaseLayout from '../components/BaseLayout.astro';
import { VermontTime } from '../domain/VermontTime.ts';
import { AstroContent } from '../persistence/AstroContent.ts';

const committee = await AstroContent.loadCommittee();
const now = VermontTime.now();
---

<BaseLayout
  title="Calendar"
  description="Upcoming meetings of the Burlington, South Burlington, and Winooski merger committee, and the dates set by state law."
  updatedOn={committee.calendarUpdatedOn()}
>
  <h1>Calendar</h1>

  <ol class="calendar-entries">
    {
      committee
        .calendar()
        .upcoming({ now })
        .entries.map((entry) => (
          <li class="calendar-entry">
            <p class="calendar-entry-when">
              <time datetime={entry.day().isoDate()}>{entry.day().longDate()}</time>
              {entry.calendarTime() && <span class="muted">{entry.calendarTime()}</span>}
            </p>
            <h2>{entry.calendarTitle()}</h2>
            <p class="calendar-entry-kind">{entry.calendarKind()}</p>
            {entry.calendarDetails().map((detail) => (
              <p>{detail}</p>
            ))}
            {entry.calendarLink() && (
              <p>
                <a href={entry.calendarLink()!.href}>{entry.calendarLink()!.text}</a>
              </p>
            )}
          </li>
        ))
    }
  </ol>
</BaseLayout>
