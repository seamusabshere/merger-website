---
import BaseLayout from '../../components/BaseLayout.astro';
import MeetingSummary from '../../components/MeetingSummary.astro';
import { VermontTime } from '../../domain/VermontTime.ts';
import { AstroContent } from '../../persistence/AstroContent.ts';

const committee = await AstroContent.loadCommittee();
const now = VermontTime.now();
const upcomingMeetings = committee.upcomingMeetings({ now });
const pastMonths = committee.pastMeetingsByMonth({ now });
---

<BaseLayout
  title="Public meetings"
  description="Upcoming and past meetings of the Burlington, South Burlington, and Winooski merger committee, with agendas, minutes, and recordings."
  updatedOn={committee.meetingsUpdatedOn()}
>
  <h1>Public meetings</h1>
  <p class="lede">
    Every meeting is open to the public, in person and by video or phone. Agendas go up at least 48 hours before each
    regular meeting. Minutes go up within 5 days after.
  </p>
  <p><a href="/participate/">How to attend and speak</a></p>

  <h2>Upcoming meetings</h2>
  {
    upcomingMeetings.length > 0 ? (
      <ul class="plain-list">
        {upcomingMeetings.map((meeting) => (
          <li>
            <MeetingSummary meeting={meeting} now={now} headingLevel="h3" />
          </li>
        ))}
      </ul>
    ) : (
      <p>No meetings are scheduled yet.</p>
    )
  }

  <h2>Past meetings</h2>
  {
    pastMonths.length > 0 ? (
      pastMonths.map((month) => (
        <section aria-label={month.label}>
          <h3>{month.label}</h3>
          <ul class="plain-list">
            {month.meetings.map((meeting) => (
              <li>
                <MeetingSummary meeting={meeting} now={now} headingLevel="h4" />
              </li>
            ))}
          </ul>
        </section>
      ))
    ) : (
      <p>The committee has not met yet.</p>
    )
  }
</BaseLayout>
