---
import BaseLayout from '../../components/BaseLayout.astro';
import MeetingTable from '../../components/MeetingTable.astro';
import { VermontTime } from '../../domain/VermontTime.ts';
import { AstroContent } from '../../persistence/AstroContent.ts';

const committee = await AstroContent.loadCommittee();
const now = VermontTime.now();
const upcomingMeetings = committee.upcomingMeetings({ now });
const pastMeetings = committee.pastMeetings({ now });
---

<BaseLayout
  title="Public meetings"
  description="Upcoming and past meetings of the Burlington, South Burlington, and Winooski merger committee, with agendas, minutes, and recordings."
  updatedOn={committee.meetingsUpdatedOn()}
>
  <h1>Public meetings</h1>
  <p class="lede">
    Every meeting is open to the public, in person and by video or phone.
  </p>
  <p><a href="/participate/">How to attend and speak</a></p>
  <p><a href="/calendar/">Calendar of expected meetings and state deadlines</a></p>

  <h2>Upcoming meetings</h2>
  <MeetingTable
    meetings={upcomingMeetings}
    caption="Upcoming meetings"
    emptyMessage="No meetings are scheduled yet."
    showMinutesAndRecording={false}
  />

  <h2>Past meetings</h2>
  <MeetingTable
    meetings={pastMeetings}
    caption="Past meetings"
    emptyMessage="The committee has not met yet."
    showMinutesAndRecording={true}
  />
</BaseLayout>
