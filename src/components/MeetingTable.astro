---
import { Meeting } from '../domain/Meeting.ts';
import { ExpectedMeeting } from '../domain/RegularMeetingSchedule.ts';
import type { VermontTime } from '../domain/VermontTime.ts';

interface Props {
  meetings: (Meeting | ExpectedMeeting)[];
  caption: string;
  emptyMessage: string;
  showMinutesAndRecording: boolean;
  now: VermontTime;
}

const { meetings, caption, emptyMessage, showMinutesAndRecording, now } = Astro.props;
---

<div class:list={['meeting-table-wide', showMinutesAndRecording && 'meeting-table-wide-past']}>
<div class="table-scroll">
  <table class:list={['meeting-table', showMinutesAndRecording ? 'meeting-table-past' : 'meeting-table-upcoming']}>
    <caption class="visually-hidden">{caption}</caption>
    <thead>
      <tr>
        <th scope="col">When</th>
        <th scope="col">Where</th>
        <th scope="col">Agenda</th>
        {
          showMinutesAndRecording && (
            <>
              <th scope="col">Minutes</th>
              <th scope="col">Recording</th>
            </>
          )
        }
      </tr>
    </thead>
    <tbody>
      {
        meetings.length === 0 ? (
          <tr>
            <td colspan={showMinutesAndRecording ? 5 : 3}>{emptyMessage}</td>
          </tr>
        ) : (
          meetings.map((meeting) =>
            meeting instanceof ExpectedMeeting ? (
              <tr>
                <th scope="row">
                  <time datetime={meeting.day().isoDate()}>{meeting.day().longDate()}</time>
                  <br />
                  {meeting.timeRange()}
                </th>
                <td>{meeting.notice()}</td>
                <td>TBD</td>
              </tr>
            ) : (
              <tr>
                <th scope="row">
                  <a href={meeting.path()}>{meeting.day().longDate()}</a>
                  <br />
                  {meeting.timeRange()}
                  {meeting.kind !== 'regular' && (
                    <>
                      <br />
                      <span class="muted">{meeting.kindName()}</span>
                    </>
                  )}
                </th>
                <td>
                  {meeting.physicalLocation ? (
                    <>
                      {meeting.physicalLocation.name}
                    </>
                  ) : meeting.onlineOnly ? (
                    <>Virtual</>
                  ) : (
                    <>TBD</>
                  )}
                  {meeting.electronicAccess && (
                    <>
                      <br />
                      {meeting.electronicAccess.url && !meeting.hasEnded({ now }) ? (
                        <a href={meeting.electronicAccess.url}>
                          {meeting.electronicAccess.joinLinkText()}
                          <span class="visually-hidden"> for {meeting.day().longDate()}</span>
                        </a>
                      ) : (
                        meeting.electronicAccess.platform
                      )}
                    </>
                  )}
                </td>
                <td>
                  {meeting.hasPostedAgenda() && meeting.agenda ? (
                    <a href={meeting.agenda.fileUrl()}>
                      Final<span class="visually-hidden"> agenda for {meeting.day().longDate()}</span>
                    </a>
                  ) : (
                    <>TBD</>
                  )}
                </td>
                {showMinutesAndRecording && (
                  <>
                    <td>
                      {meeting.minutes ? (
                        <a href={meeting.minutes.fileUrl() ?? `${meeting.path()}#minutes`}>
                          {meeting.minutes.isDraft() ? 'Draft' : 'Approved'}
                          <span class="visually-hidden"> minutes for {meeting.day().longDate()}</span>
                        </a>
                      ) : (
                        <>TBD</>
                      )}
                    </td>
                    <td>
                      {meeting.recording ? (
                        <a href={meeting.recording.url}>
                          {meeting.recording.watchLinkText()}
                          <span class="visually-hidden"> for {meeting.day().longDate()}</span>
                        </a>
                      ) : (
                        <>TBD</>
                      )}
                    </td>
                  </>
                )}
              </tr>
            ),
          )
        )
      }
    </tbody>
  </table>
</div>
</div>
{
  showMinutesAndRecording &&
    (meetings.length === 0 ? (
      <p class="meeting-cards">{emptyMessage}</p>
    ) : (
      <ol class="meeting-cards" aria-label={caption}>
        {meetings.map((meeting) =>
          meeting instanceof ExpectedMeeting ? (
            <li class="meeting-card">
              <p class="meeting-card-when">
                <time datetime={meeting.day().isoDate()}>{meeting.day().longDate()}</time>
                <br />
                {meeting.timeRange()}
              </p>
              <p class="meeting-card-where">{meeting.notice()}</p>
              <dl class="meeting-card-files">
                <dt>Agenda</dt>
                <dd>TBD</dd>
              </dl>
            </li>
          ) : (
            <li class="meeting-card">
              <p class="meeting-card-when">
                <a href={meeting.path()}>
                  <time datetime={meeting.day().isoDate()}>{meeting.day().longDate()}</time>
                </a>
                <br />
                {meeting.timeRange()}
                {meeting.kind !== 'regular' && (
                  <>
                    <br />
                    <span class="muted">{meeting.kindName()}</span>
                  </>
                )}
              </p>
              <p class="meeting-card-where">
                {meeting.physicalLocation ? (
                  meeting.physicalLocation.name
                ) : meeting.onlineOnly ? (
                  'Virtual'
                ) : (
                  'TBD'
                )}
                {meeting.electronicAccess && (
                  <>
                    <br />
                    {meeting.electronicAccess.url && !meeting.hasEnded({ now }) ? (
                      <a href={meeting.electronicAccess.url}>
                        {meeting.electronicAccess.joinLinkText()}
                        <span class="visually-hidden"> for {meeting.day().longDate()}</span>
                      </a>
                    ) : (
                      meeting.electronicAccess.platform
                    )}
                  </>
                )}
              </p>
              <dl class="meeting-card-files">
                <dt>Agenda</dt>
                <dd>
                  {meeting.hasPostedAgenda() && meeting.agenda ? (
                    <a href={meeting.agenda.fileUrl()}>
                      Final<span class="visually-hidden"> agenda for {meeting.day().longDate()}</span>
                    </a>
                  ) : (
                    'TBD'
                  )}
                </dd>
                <dt>Minutes</dt>
                <dd>
                  {meeting.minutes ? (
                    <a href={meeting.minutes.document?.pdfFile()?.url ?? `${meeting.path()}#minutes`}>
                      {meeting.minutes.isDraft() ? 'Draft' : 'Approved'}
                      <span class="visually-hidden"> minutes for {meeting.day().longDate()}</span>
                    </a>
                  ) : (
                    'TBD'
                  )}
                </dd>
                <dt>Recording</dt>
                <dd>
                    {meeting.recording ? (
                      <a href={meeting.recording.url}>
                        Watch on <span class="meeting-card-host">{meeting.recording.host}</span>
                        <span class="visually-hidden"> for {meeting.day().longDate()}</span>
                      </a>
                    ) : (
                      'TBD'
                    )}
                </dd>
              </dl>
            </li>
          ),
        )}
      </ol>
    ))
}
