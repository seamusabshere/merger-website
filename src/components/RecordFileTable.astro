---
import type { Committee } from '../domain/Committee.ts';
import type { Document } from '../domain/Document.ts';

interface Props {
  documents: Document[];
  committee: Committee;
  caption: string;
  emptyMessage: string;
}

const { documents, committee, caption, emptyMessage } = Astro.props;
---

<div class="table-scroll">
<table>
  <caption class="visually-hidden">{caption}</caption>
  <thead>
    <tr>
      <th scope="col">File</th>
      <th scope="col">Author</th>
      <th scope="col">Date</th>
    </tr>
  </thead>
  <tbody>
    {
      documents.length === 0 ? (
        <tr>
          <td colspan="3">{emptyMessage}</td>
        </tr>
      ) : (
        documents.flatMap((document) =>
          document.files.map((file) => {
            const meetings = committee.meetingsUsing({ document });
            return (
            <tr>
              <th scope="row">
                <a href={file.url} hreflang={file.language}>
                  {document.fileName({ file })}
                </a>{' '}
                <span class="file-type">({file.typeAndSize()})</span>
                {file.accessibilityNote() && (
                  <>
                    <br />
                    <span class="muted">{file.accessibilityNote()}</span>
                  </>
                )}
              </th>
              <td>{document.publisher}</td>
              <td>
                {
                  meetings.length > 0 ? (
                    <ul class="plain-list">
                      {[...meetings].reverse().map((meeting) => (
                        <li>
                          <a href={meeting.path()}>
                            <time datetime={meeting.day().isoDate()}>{meeting.day().shortDate()}</time>
                          </a>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    document.publishedDescription()
                  )
                }
              </td>
            </tr>
            );
          }),
        )
      )
    }
  </tbody>
</table>
</div>
