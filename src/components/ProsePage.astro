---
import type { Page } from '../domain/Page.ts';
import BaseLayout from './BaseLayout.astro';

interface Props {
  page: Page<any>;
}

const { page } = Astro.props;
const Body = page.body;
---

<BaseLayout title={page.title} description={page.description} updatedOn={page.updatedOn}>
  <h1>{page.title}</h1>
  <slot name="before" />
  <Body />
  <slot />
</BaseLayout>
