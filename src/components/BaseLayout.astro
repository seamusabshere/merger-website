---
import '../styles/site.css';
import latinFontUrl from '@fontsource-variable/libre-franklin/files/libre-franklin-latin-wght-normal.woff2?url';
import OfficialBanner from './OfficialBanner.astro';
import type { VermontCalendarDay } from '../domain/VermontTime.ts';
import { AstroContent } from '../persistence/AstroContent.ts';

interface Props {
  title: string;
  description: string;
  updatedOn: VermontCalendarDay;
}

const { title, description, updatedOn } = Astro.props;
const committee = await AstroContent.loadCommittee();
const currentPath = Astro.url.pathname;
const siteName = 'Burlington, South Burlington, and Winooski Merger Study';

const navigation = [
  { href: '/', label: 'Home' },
  { href: '/meetings/', label: 'Public meetings' },
  { href: '/records/', label: 'Public records' },
  { href: '/participate/', label: 'How to participate' },
  { href: '/history/', label: 'History of school mergers' },
  { href: '/act-170/', label: 'Act 170 of 2026' },
  { href: '/cesa/', label: 'Difference from the CESA' },
  { href: '/members/', label: 'Committee members' },
  { href: '/accessibility/', label: 'Accessibility' },
  { href: '/contact/', label: 'Contact us' },
];

const isCurrent = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{currentPath === '/' ? siteName : `${title} | ${siteName}`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(currentPath, Astro.site)} />
    <link rel="preload" href={latinFontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={currentPath === '/' ? siteName : title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(currentPath, Astro.site)} />
    <meta property="og:locale" content="en_US" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <OfficialBanner
      cityList={committee.cityList()}
      howYouKnow={committee.howYouKnow()}
      districts={committee.districts}
    />
    <header class="site-header">
      <div class="wrap">
        <a class="site-name" href="/">
          {siteName}
          <small>Act 170 merger committee</small>
        </a>
        <nav class="site-nav" aria-label="Main">
          <details class="site-menu">
            <summary>Menu</summary>
            <ul>
              {
                navigation.map((item) => (
                  <li>
                    <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <div class="wrap">
        <slot />
        <p class="updated">Last updated {updatedOn.shortDate()}.</p>
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>
          This is the official website of the Act 170 merger committee for the Burlington, South Burlington, and
          Winooski school districts. The committee studies whether to merge. It has not decided.
        </p>
        <ul aria-label="School district websites">
          {
            committee.districts.map((district) => (
              <li>
                <a href={district.website}>{district.name}</a>
              </li>
            ))
          }
        </ul>
        <p><a href="/accessibility/">Accessibility</a> · <a href="/contact/">Contact us</a></p>
      </div>
    </footer>
  </body>
</html>
