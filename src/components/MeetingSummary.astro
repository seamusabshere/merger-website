---
import type { Meeting } from '../domain/Meeting.ts';
import type { VermontTime } from '../domain/VermontTime.ts';

interface Props {
  meeting: Meeting;
  now: VermontTime;
  headingLevel: 'h2' | 'h3' | 'h4';
}

const { meeting, now, headingLevel: Heading } = Astro.props;
const agendaDeadline = meeting.agendaDeadline();
const hasStarted = meeting.hasStarted({ now });
---

<Heading class="item-title"><a href={meeting.path()}>{meeting.day().longDate()}</a></Heading>
<p>
  {meeting.timeRange()} at {meeting.physicalLocation.name}, {meeting.physicalLocation.city}
  {meeting.electronicAccess && <>, and on {meeting.electronicAccess.platform}</>}
</p>
<ul>
  <li>
    {
      meeting.hasPostedAgenda() ? (
        <a href={`${meeting.path()}#agenda`}>Agenda</a>
      ) : agendaDeadline && !hasStarted ? (
        <>Agenda coming by {agendaDeadline.dateAndTime()}</>
      ) : (
        <>Agenda not posted here</>
      )
    }
  </li>
  {
    hasStarted && (
      <li>
        {meeting.minutes ? (
          <a href={`${meeting.path()}#minutes`}>Minutes{meeting.minutes.isDraft() ? ' (draft)' : ''}</a>
        ) : (
          <>Minutes not posted yet</>
        )}
      </li>
    )
  }
  {
    hasStarted && (
      <li>{meeting.recording ? <a href={meeting.recording.url}>Recording on {meeting.recording.host}</a> : <>Recording not posted yet</>}</li>
    )
  }
</ul>
