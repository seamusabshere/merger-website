---
import type { Meeting } from '../domain/Meeting.ts';
import type { VermontTime } from '../domain/VermontTime.ts';

interface Props {
  meeting: Meeting;
  now: VermontTime;
}

const { meeting, now } = Astro.props;
const location = meeting.physicalLocation;
const access = meeting.electronicAccess;
const hasEnded = meeting.hasEnded({ now });
---

<dl class="facts">
  <dt>When</dt>
  <dd>
    {meeting.day().longDate()}<br />
    {meeting.timeRange()}
  </dd>

  <dt>In person</dt>
  <dd>
    {
      location ? (
        <>
          {location.name}
          {location.room && (
            <>
              <br />
              {location.room}
            </>
          )}
          <br />
          {location.streetAddress}
          <br />
          {location.cityLine()}
          <br />
          <a href={location.mapUrl()}>Map of {location.streetAddress}</a>
          {location.accessNotes.length > 0 && (
            <ul>
              {location.accessNotes.map((note) => (
                <li>{note}</li>
              ))}
            </ul>
          )}
        </>
      ) : (
        <>To be determined.</>
      )
    }
  </dd>

  {
    access && (
      <>
        <dt>By video</dt>
        <dd>
          {hasEnded ? (
            <>It met on {access.platform}.</>
          ) : access.url ? (
            <>
              <a href={access.url}>Join on {access.platform}</a>
              {access.meetingId && (
                <>
                  <br />
                  Meeting ID: {access.meetingId}
                </>
              )}
              {access.passcode && (
                <>
                  <br />
                  Passcode: {access.passcode}
                </>
              )}
            </>
          ) : (
            <>The {access.platform} link is not posted yet.</>
          )}
        </dd>
        <dt>By phone</dt>
        <dd>
          {hasEnded ? (
            access.phoneNumber ? (
              <>The number was {access.phoneNumber}{access.phonePin ? `, PIN ${access.phonePin}` : ''}.</>
            ) : (
              <>No phone number was posted.</>
            )
          ) : access.phoneNumber ? (
            <>
              Call <a href={access.telephoneHref()}>{access.phoneNumber}</a>
              {access.phonePin && (
                <>
                  <br />
                  PIN: {access.phonePin}
                </>
              )}
            </>
          ) : (
            <>The phone number is not posted yet.</>
          )}
        </dd>
      </>
    )
  }
</dl>
